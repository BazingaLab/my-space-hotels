PORT=5000
NODE_ENV=development

# Get these from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Comma-separated list of allowed origins
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app

# Razorpay Dashboard → Settings → API Keys (use TEST mode keys for staging)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Razorpay Dashboard → Settings → Webhooks → the secret set on the webhook
# pointed at POST /api/payments/webhook (a SEPARATE value from the key secret above)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
