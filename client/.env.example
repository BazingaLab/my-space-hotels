# Local development
VITE_API_URL=http://localhost:5000

# In production (Vercel), set this to your deployed backend URL
# VITE_API_URL=https://your-backend.vercel.app

# Supabase Dashboard → Settings → API — the PUBLIC anon key, never the
# service_role key (that one belongs only in server/.env)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Google Cloud Console → APIs & Services → Credentials (Maps JavaScript API)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
