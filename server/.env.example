PORT=5000
NODE_ENV=development

# Get these from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Comma-separated list of allowed origins
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app

# Razorpay Dashboard → Settings → API Keys (use TEST mode keys for staging)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Razorpay Dashboard → Settings → Webhooks → the secret set on the webhook
# pointed at POST /api/payments/webhook (a SEPARATE value from the key secret above)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Optional — booking confirmation emails (services/emailService.js).
# Without these set, emails are safely skipped (logged, never faked) and
# nothing else in the booking flow is affected. Get an API key from
# https://resend.com, and EMAIL_FROM must be a domain/address verified
# there (e.g. "My Space Hotels <bookings@myspacehotels.in>").
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=My Space Hotels <bookings@yourdomain.com>
